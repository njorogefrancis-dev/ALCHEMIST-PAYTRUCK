<Window x:Class="AlchemistPayTrack.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AlchemistPayTrack.Presentation"
        Title="Alchemist PayTrack - Sign In"
        Height="640" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}"/>
    </Window.Resources>

    <Grid>
        <ScrollViewer Style="{StaticResource ScrollablePanel}">
        <Grid Margin="30">
            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Alchemist PayTrack" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Text="Sign in to continue" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource InfoBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding InfoMessage, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" TextAlignment="Center"/>

                <!-- ===================== LOGIN ===================== -->
                <StackPanel x:Name="LoginPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="Login">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Username" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="UsernameBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" Style="{StaticResource StepLabel}"/>
                    <Grid Margin="0,0,0,6">
                        <PasswordBox x:Name="PasswordBox" Visibility="Visible"/>
                        <TextBox x:Name="PasswordVisibleBox" Visibility="Collapsed"/>
                    </Grid>
                    <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Margin="0,0,0,16"
                              Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Button x:Name="SubmitButton" Content="Sign In" Click="SubmitButton_Click"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,0,0,10"/>

                    <Button Content="Forgot password?" Click="ForgotPassword_Click" Style="{StaticResource NeutralButton}"
                            Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ===================== SETUP (first run) ===================== -->
                <StackPanel x:Name="SetupPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="Setup">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Full Name" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="SetupFullNameBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Username" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="SetupUsernameBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Password" Style="{StaticResource StepLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <PasswordBox x:Name="SetupPasswordBox" PasswordChanged="SetupPasswordBox_PasswordChanged" Visibility="Visible"/>
                        <TextBox x:Name="SetupPasswordVisibleBox" TextChanged="SetupPasswordVisibleBox_TextChanged" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Strength meter -->
                    <Grid Height="6" Margin="0,4,0,4" HorizontalAlignment="Left" Width="160">
                        <Border Background="{DynamicResource BorderBrush}" CornerRadius="3"/>
                        <Border Background="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToBrush}}"
                                CornerRadius="3" HorizontalAlignment="Left"
                                Width="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToWidth}}"/>
                    </Grid>
                    <TextBlock Text="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToLabel}}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ShowSetupPasswordCheck" Content="Show password" Margin="0,0,0,10"
                              Checked="ShowSetupPasswordCheck_Changed" Unchecked="ShowSetupPasswordCheck_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="Confirm Password" Style="{StaticResource StepLabel}"/>
                    <PasswordBox x:Name="SetupConfirmPasswordBox" Margin="0,0,0,16"/>

                    <TextBlock Text="Security Questions (required for account recovery)" Style="{StaticResource SectionHeader}" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Text="Question 1" Style="{StaticResource StepLabel}"/>
                    <ComboBox x:Name="Question1Combo" Margin="0,0,0,6" SelectedIndex="0"
                              ItemsSource="{Binding Source={x:Static local:LoginViewModel.AvailableSecurityQuestions}}"/>
                    <TextBox x:Name="Answer1Box" Margin="0,0,0,12"/>

                    <TextBlock Text="Question 2" Style="{StaticResource StepLabel}"/>
                    <ComboBox x:Name="Question2Combo" Margin="0,0,0,6" SelectedIndex="1"
                              ItemsSource="{Binding Source={x:Static local:LoginViewModel.AvailableSecurityQuestions}}"/>
                    <TextBox x:Name="Answer2Box" Margin="0,0,0,12"/>

                    <TextBlock Text="Question 3" Style="{StaticResource StepLabel}"/>
                    <ComboBox x:Name="Question3Combo" Margin="0,0,0,6" SelectedIndex="2"
                              ItemsSource="{Binding Source={x:Static local:LoginViewModel.AvailableSecurityQuestions}}"/>
                    <TextBox x:Name="Answer3Box" Margin="0,0,0,16"/>

                    <Button Content="Create Account" Click="SubmitButton_Click"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Padding="0,10"/>
                </StackPanel>

                <!-- ===================== FORCED PASSWORD CHANGE (expired) ===================== -->
                <StackPanel x:Name="ChangeExpiredPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="ChangeExpired">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="New Password" Style="{StaticResource StepLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <PasswordBox x:Name="ExpiredNewPasswordBox" PasswordChanged="ExpiredNewPasswordBox_PasswordChanged" Visibility="Visible"/>
                        <TextBox x:Name="ExpiredNewPasswordVisibleBox" TextChanged="ExpiredNewPasswordVisibleBox_TextChanged" Visibility="Collapsed"/>
                    </Grid>

                    <Grid Height="6" Margin="0,4,0,4" HorizontalAlignment="Left" Width="160">
                        <Border Background="{DynamicResource BorderBrush}" CornerRadius="3"/>
                        <Border Background="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToBrush}}"
                                CornerRadius="3" HorizontalAlignment="Left"
                                Width="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToWidth}}"/>
                    </Grid>
                    <TextBlock Text="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToLabel}}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                    <CheckBox x:Name="ShowExpiredPasswordCheck" Content="Show password" Margin="0,0,0,10"
                              Checked="ShowExpiredPasswordCheck_Changed" Unchecked="ShowExpiredPasswordCheck_Changed"
                              Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="Confirm New Password" Style="{StaticResource StepLabel}"/>
                    <PasswordBox x:Name="ExpiredConfirmPasswordBox" Margin="0,0,0,16"/>

                    <Button Content="Set New Password" Click="SubmitButton_Click"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Padding="0,10"/>
                </StackPanel>

                <!-- ===================== RECOVER: enter username ===================== -->
                <StackPanel x:Name="RecoverUsernamePanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="RecoverUsername">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Enter your username to begin account recovery." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Username" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="RecoveryUsernameBox" Margin="0,0,0,16"/>

                    <Button Content="Continue" Click="SubmitButton_Click"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,0,0,10"/>
                    <Button Content="Back to Sign In" Click="CancelToLogin_Click" Style="{StaticResource NeutralButton}"
                            Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ===================== RECOVER: answer questions ===================== -->
                <StackPanel x:Name="RecoverAnswersPanel">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="RecoverAnswers">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ItemsControl ItemsSource="{Binding RecoveryQuestions}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource StepLabel}" TextWrapping="Wrap" Margin="0,6,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Answer 1" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="RecoveryAnswer1Box" Margin="0,0,0,8"/>
                    <TextBlock Text="Answer 2" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="RecoveryAnswer2Box" Margin="0,0,0,8"/>
                    <TextBlock Text="Answer 3" Style="{StaticResource StepLabel}"/>
                    <TextBox x:Name="RecoveryAnswer3Box" Margin="0,0,0,14"/>

                    <TextBlock Text="New Password" Style="{StaticResource StepLabel}"/>
                    <PasswordBox x:Name="RecoveryNewPasswordBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Confirm New Password" Style="{StaticResource StepLabel}"/>
                    <PasswordBox x:Name="RecoveryConfirmPasswordBox" Margin="0,0,0,16"/>

                    <Button Content="Reset Password" Click="SubmitButton_Click"
                            Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch" Padding="0,10" Margin="0,0,0,10"/>
                    <Button Content="Back to Sign In" Click="CancelToLogin_Click" Style="{StaticResource NeutralButton}"
                            Background="Transparent" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{x:Static local:AppBranding.DeveloperAttributionShort}" FontSize="9.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.ToolTip>
                        <TextBlock TextWrapping="Wrap" MaxWidth="240">
                            <Run Text="{x:Static local:AppBranding.WatermarkShort}" FontWeight="Bold"/>
                            <LineBreak/>
                            <Run Text="{x:Static local:AppBranding.SupportEmail}"/>
                            <LineBreak/>
                            <Run Text="{x:Static local:AppBranding.SupportPhone}"/>
                        </TextBlock>
                    </TextBlock.ToolTip>
                </TextBlock>

            </StackPanel>
        </Grid>
        </ScrollViewer>
        <local:WatermarkOverlay/>
    </Grid>
</Window>
