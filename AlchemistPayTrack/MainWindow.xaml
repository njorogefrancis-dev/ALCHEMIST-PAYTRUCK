<Window x:Class="AlchemistPayTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlchemistPayTrack.Presentation"
        Title="Alchemist PayTrack" Height="740" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>

        <!-- ===================== DASHBOARD ===================== -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <StackPanel Margin="24">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding CurrentMonthLabel}" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⟳ Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource NeutralButton}" VerticalAlignment="Top"/>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10"
                           Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}"/>

                <!-- Loading skeleton (shown only while first loading) -->
                <UniformGrid Columns="4" Rows="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12"><Border Style="{StaticResource Skeleton}" Width="80" Height="60"/></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12"><Border Style="{StaticResource Skeleton}" Width="80" Height="60"/></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12"><Border Style="{StaticResource Skeleton}" Width="80" Height="60"/></Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Border Style="{StaticResource Skeleton}" Width="80" Height="60"/></Border>
                </UniformGrid>

                <!-- KPI widget grid -->
                <UniformGrid Columns="4" Rows="2" Margin="0,0,0,16" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">

                    <!-- Workers Present -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeSuccessBg}" HorizontalAlignment="Left">
                                <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WorkersPresent}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Workers Present" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Workers Absent -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeDangerBg}" HorizontalAlignment="Left">
                                <TextBlock Text="🚫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WorkersAbsent}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Workers Absent" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Clocked In -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeInfoBg}" HorizontalAlignment="Left">
                                <TextBlock Text="⏱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WorkersClockedIn}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Clocked In (on site)" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Clocked Out -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeNeutralBg}" HorizontalAlignment="Left">
                                <TextBlock Text="🏁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WorkersClockedOut}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Clocked Out (done)" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Today's Payroll -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeWarningBg}" HorizontalAlignment="Left">
                                <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding TodayPayroll, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Today's Payroll" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Weekly Payroll -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeWarningBg}" HorizontalAlignment="Left">
                                <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WeeklyPayroll, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Weekly Payroll" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Monthly Payroll -->
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeWarningBg}" HorizontalAlignment="Left">
                                <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding MonthlyPayroll, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Monthly Payroll" Style="{StaticResource StatLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Overtime - not tracked yet -->
                    <Border Style="{StaticResource Card}" Opacity="0.6">
                        <StackPanel>
                            <Border Style="{StaticResource KpiIconBadge}" Background="{DynamicResource BadgeNeutralBg}" HorizontalAlignment="Left">
                                <TextBlock Text="⏳" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="—" Style="{StaticResource StatValue}" Margin="0,10,0,0"/>
                            <TextBlock Text="Overtime" Style="{StaticResource StatLabel}"/>
                            <Border Style="{StaticResource BadgeNeutral}" Margin="0,6,0,0">
                                <TextBlock Text="Coming soon" Style="{StaticResource BadgeTextNeutral}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Charts -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0">
                        <StackPanel>
                            <TextBlock Text="Attendance This Week" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding WeeklyAttendanceChart}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="46" Margin="4,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Value}" HorizontalAlignment="Center" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Height="{Binding BarHeight}" Background="{DynamicResource PrimaryBrush}"
                                                    CornerRadius="4,4,0,0" VerticalAlignment="Bottom" MinHeight="2"/>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11"
                                                       Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="2">
                        <StackPanel>
                            <TextBlock Text="Payroll Trend (6 months)" Style="{StaticResource SectionHeader}"/>
                            <ItemsControl ItemsSource="{Binding PayrollTrendChart}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="46" Margin="4,0" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Value, StringFormat={}{0:N0}}" HorizontalAlignment="Center" FontSize="9.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Border Height="{Binding BarHeight}" Background="{DynamicResource WarningBrush}"
                                                    CornerRadius="4,4,0,0" VerticalAlignment="Bottom" MinHeight="2"/>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11"
                                                       Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⏱ Clock In / Out" Margin="0,0,10,0"
                                    Command="{Binding DataContext.NavigateClockCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="💰 Run Payroll" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"
                                    Command="{Binding DataContext.NavigatePayrollCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="👥 Add Worker" Style="{StaticResource NeutralButton}" Margin="0,0,10,0"
                                    Command="{Binding DataContext.NavigateWorkersCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Content="🧾 Record Payment" Style="{StaticResource NeutralButton}"
                                    Command="{Binding DataContext.NavigatePaymentsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent Activity + placeholders for future phases -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Padding="0">
                        <StackPanel>
                            <TextBlock Text="Recent Activity" Style="{StaticResource SectionHeader}" Margin="18,18,18,0"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="18,8,18,18">
                            <ItemsControl ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Style="{StaticResource BodyText}"/>
                                                    <TextBlock Text=" · " Style="{StaticResource MutedText}"/>
                                                    <TextBlock Text="{Binding TableName}" Style="{StaticResource MutedText}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,2,0,0">
                                                    <Run Text="{Binding Username, Mode=OneWay}"/>
                                                    <Run Text=" — "/>
                                                    <Run Text="{Binding Timestamp, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Margin="18,10,18,24" Visibility="{Binding RecentActivities.Count, Converter={StaticResource BoolToVis}, ConverterParameter=ZeroToVisible}">
                                <TextBlock Text="📭" Style="{StaticResource EmptyStateIcon}"/>
                                <TextBlock Text="No activity yet. Actions like adding workers or recording payments will show up here." Style="{StaticResource EmptyStateText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Opacity="0.7">
                            <StackPanel>
                                <TextBlock Text="🏗 Active Projects" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="Coming in a later phase" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Opacity="0.7">
                            <StackPanel>
                                <TextBlock Text="📝 Pending Approvals" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="Coming in a later phase" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Opacity="0.7">
                            <StackPanel>
                                <TextBlock Text="🔔 Notifications" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                <Border Style="{StaticResource BadgeNeutral}">
                                    <TextBlock Text="Coming in a later phase" Style="{StaticResource BadgeTextNeutral}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </DataTemplate>

        <!-- ===================== CLOCK IN / OUT ===================== -->
        <DataTemplate DataType="{x:Type vm:ClockViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Clock In / Out" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Worker list, beside the clock action panel -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Search by name, phone, or national ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Border Style="{StaticResource Card}" Grid.Row="1" Padding="0">
                                <Grid>
                                    <DataGrid ItemsSource="{Binding FilteredWorkers}" SelectedItem="{Binding SelectedWorker}"
                                              AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="500">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}"/>
                                            <DataGridTextColumn Header="Category" Binding="{Binding WorkerCategory}"/>
                                            <DataGridTextColumn Header="Job Role" Binding="{Binding JobRole}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel VerticalAlignment="Center" Margin="24"
                                                Visibility="{Binding FilteredWorkers.Count, Converter={StaticResource BoolToVis}, ConverterParameter=ZeroToVisible}">
                                        <TextBlock Text="🔍" Style="{StaticResource EmptyStateIcon}"/>
                                        <TextBlock Text="No workers match your search." Style="{StaticResource EmptyStateText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Clock action panel -->
                        <Border Style="{StaticResource Card}" Grid.Column="2" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Clock Action" Style="{StaticResource SectionHeader}"/>

                                <TextBlock Text="Selected Worker" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding SelectedWorker.FullName}" FontWeight="Bold" Style="{StaticResource BodyText}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock Text="Pick a worker from the list on the left" Style="{StaticResource MutedText}" FontSize="11.5" Margin="0,0,0,16"
                                           Visibility="{Binding SelectedWorker, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                                            Visibility="{Binding CanClockWorkers, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Clock In" Command="{Binding ClockInCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"/>
                                    <Button Content="Clock Out" Command="{Binding ClockOutCommand}" Style="{StaticResource DangerButton}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource BodyText}">
                                    <Run Text="Hours worked this month: "/>
                                    <Run Text="{Binding HoursWorkedThisMonth, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>

                                <Button Content="Refresh List" Command="{Binding RefreshCommand}" Style="{StaticResource NeutralButton}" Margin="0,16,0,0" HorizontalAlignment="Left"/>

                                <TextBlock Text="Loading..." Margin="0,10,0,0" FontStyle="Italic" Style="{StaticResource MutedText}"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Today's attendance: present / absent, filterable -->
                    <Border Style="{StaticResource Card}" Grid.Row="2" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Today's Attendance" Style="{StaticResource SectionHeader}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            Visibility="{Binding CanPrintAttendance, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Print" Command="{Binding PrintAttendanceCommand}" Style="{StaticResource NeutralButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
                                    <Button Content="Export PDF" Command="{Binding ExportAttendanceCommand}" Style="{StaticResource SuccessButton}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Run Text="Present: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding PresentCount, Mode=OneWay}" FontWeight="Bold" Foreground="#16A34A"/>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,20,0">
                                    <Run Text="Absent: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding AbsentCount, Mode=OneWay}" FontWeight="Bold" Foreground="#DC2626"/>
                                </TextBlock>
                                <TextBox Width="280" Text="{Binding AttendanceSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search present/absent by name, phone, ID, or role"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Present" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,0,0,6"/>
                                    <DataGrid ItemsSource="{Binding PresentWorkers}" AutoGenerateColumns="False" IsReadOnly="True"
                                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Job Role" Binding="{Binding JobRole}"/>
                                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Absent" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,6"/>
                                    <DataGrid ItemsSource="{Binding AbsentWorkers}" AutoGenerateColumns="False" IsReadOnly="True"
                                              BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                                            <DataGridTextColumn Header="Job Role" Binding="{Binding JobRole}"/>
                                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        <!-- ===================== PAYROLL ===================== -->
        <DataTemplate DataType="{x:Type vm:PayrollViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Payroll" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Calculate Payroll" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Year:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BodyText}"/>
                            <TextBox Width="80" Text="{Binding SelectedYear}" Margin="0,0,16,0"/>
                            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource BodyText}"/>
                            <TextBox Width="60" Text="{Binding SelectedMonth}" Margin="0,0,16,0"/>
                            <Button Content="Calculate" Command="{Binding CalculateCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding DataContext.CanGeneratePayroll, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Export Excel" Command="{Binding ExportToExcelCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"
                                    Visibility="{Binding DataContext.CanExportReports, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Export PDF" Command="{Binding ExportToPdfCommand}" Style="{StaticResource DangerButton}"
                                    Visibility="{Binding DataContext.CanExportReports, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock>
                            <Run Text="{Binding PeriodLabel, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <LineBreak/>
                            <Run Text="{Binding StatusMessage, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2" Padding="0">
                    <DataGrid ItemsSource="{Binding PayrollEntries}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Worker ID" Binding="{Binding WorkerId}"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding WorkerName}"/>
                            <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyRate}"/>
                            <DataGridTextColumn Header="Days Worked" Binding="{Binding DaysWorked}"/>
                            <DataGridTextColumn Header="Hours Worked" Binding="{Binding HoursWorked}"/>
                            <DataGridTextColumn Header="Gross Earnings" Binding="{Binding GrossEarnings}"/>
                            <DataGridTextColumn Header="Total Paid" Binding="{Binding TotalPaid}"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding Balance}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===================== PAYMENTS ===================== -->
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Payments &amp; Advances" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,16" MaxWidth="700" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Record a Payment" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Search Worker" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding WorkerSearchTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Tag="Search by name, phone, or national ID"/>

                        <TextBlock Text="Worker" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding FilteredWorkers}" SelectedItem="{Binding SelectedWorker}"
                                  DisplayMemberPath="FullName" Margin="0,0,0,12"/>

                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,12"
                                Visibility="{Binding ZeroDaysWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ZeroDaysWarning}" TextWrapping="Wrap" FontSize="11.5" Foreground="#B91C1C"/>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,4,0,0" FontSize="11" Opacity="0.7">
                                    <Run Text="Daily rate: "/>
                                    <Run Text="{Binding SelectedWorker.DailyWageRate, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding WeekBalanceHint}" Style="{StaticResource BodyText}" Margin="0,2,0,0" FontSize="11" Opacity="0.7"/>
                                <TextBlock Text="{Binding MonthBalanceHint}" Style="{StaticResource BodyText}" Margin="0,2,0,0" FontSize="11" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Use week balance" Command="{Binding UseWeekBalanceCommand}" Style="{StaticResource NeutralButton}" Margin="0,0,8,0" Padding="8,4" FontSize="11"/>
                                    <Button Content="Use month balance" Command="{Binding UseMonthBalanceCommand}" Style="{StaticResource NeutralButton}" Padding="8,4" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Method" Style="{StaticResource FieldLabel}"/>
                                <ComboBox SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="Cash"/>
                                    <ComboBoxItem Content="M-Pesa"/>
                                    <ComboBoxItem Content="Bank Transfer"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="M-Pesa Transaction Code (if applicable)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MpesaCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Record Payment" Command="{Binding RecordPaymentCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"
                                    Visibility="{Binding DataContext.CanRecordPayments, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="View Last Receipt" Command="{Binding ViewLastReceiptCommand}" Style="{StaticResource NeutralButton}"
                                    Visibility="{Binding DataContext.CanPrintReceipts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2" Padding="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,14,16,10"
                                    Visibility="{Binding DataContext.CanPrintReceipts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <Button Content="Select All" Command="{Binding SelectAllOnPageCommand}" Style="{StaticResource NeutralButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="Clear Selection" Command="{Binding ClearSelectionCommand}" Style="{StaticResource NeutralButton}" Padding="10,4" FontSize="11" Margin="0,0,16,0"/>
                            <Button Content="Print Selected Receipts" Command="{Binding PrintSelectedReceiptsCommand}" Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
                            <Button Content="Export Selected Receipts" Command="{Binding ExportSelectedReceiptsCommand}" Style="{StaticResource SuccessButton}" Padding="10,4" FontSize="11"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding RecentPayments}" AutoGenerateColumns="False" BorderThickness="0" MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="36"/>
                                <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNumber}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Worker" Binding="{Binding WorkerName}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountPaid}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="M-Pesa Code" Binding="{Binding MpesaCode}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding PaymentDate}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Actions">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="View" Padding="8,3" FontSize="11" Style="{StaticResource NeutralButton}"
                                                    Command="{Binding DataContext.ViewReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.CanPrintReceipts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource NeutralButton}" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===================== WORKERS ===================== -->
        <DataTemplate DataType="{x:Type vm:WorkersViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Workers" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <!-- Add / Edit Worker form -->
                <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,16"
                        Visibility="{Binding CanUseWorkerForm, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionHeader}"/>
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Full Name *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewWorkerFullName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="National ID *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewWorkerNationalId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Phone Number" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewWorkerPhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewWorkerCategory, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Job Role" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableJobRoles}" SelectedItem="{Binding NewWorkerJobRole}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Daily Wage Rate *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewWorkerDailyWageRate, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding SaveButtonLabel}" Command="{Binding AddWorkerCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,10,0"/>
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" Style="{StaticResource NeutralButton}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Search / row actions -->
                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
                    <TextBox Width="220" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search by name, phone number, or national ID"/>
                    <Button Content="Search" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
                    <ComboBox Width="120" Margin="12,0,0,0" ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding FilterCategory}" ToolTip="Filter by category"/>
                    <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding FilterStatus}" ToolTip="Filter by status"/>
                    <Button Content="Reload" Command="{Binding LoadWorkersCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                    <Button Content="Import from CSV" Command="{Binding ImportWorkersCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanRegisterWorkers, Converter={StaticResource BoolToVis}}"
                            ToolTip="CSV columns: FullName, NationalId, PhoneNumber, Category, JobRole, DailyWageRate"/>
                    <Button Content="Edit Selected" Command="{Binding EditWorkerCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanEditWorkers, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Deactivate Selected" Command="{Binding DeactivateWorkerCommand}" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanDeleteWorkers, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Worker list -->
                <Border Style="{StaticResource Card}" Grid.Row="3" Padding="0">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Workers}" SelectedItem="{Binding SelectedWorker}"
                                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="500"
                                  Visibility="{Binding Workers.Count, Converter={StaticResource BoolToVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Worker ID" Binding="{Binding WorkerId}"/>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding WorkerCategory}"/>
                            <DataGridTextColumn Header="Job Role" Binding="{Binding JobRole}"/>
                            <DataGridTextColumn Header="Daily Rate" Binding="{Binding DailyWageRate}"/>
                            <DataGridTemplateColumn Header="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeDangerBg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel VerticalAlignment="Center" Margin="24"
                                    Visibility="{Binding Workers.Count, Converter={StaticResource BoolToVis}, ConverterParameter=ZeroToVisible}">
                            <TextBlock Text="👷" Style="{StaticResource EmptyStateIcon}"/>
                            <TextBlock Text="No workers yet. Use the form above to add your first worker." Style="{StaticResource EmptyStateText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource NeutralButton}" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===================== ACTIVITY LOG ===================== -->
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Activity Log" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource NeutralButton}" Margin="16,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource Card}" Grid.Row="1" Padding="0">
                    <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}"/>
                            <DataGridTextColumn Header="User" Binding="{Binding Username}"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}"/>
                            <DataGridTextColumn Header="Table" Binding="{Binding TableName}"/>
                            <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device}"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding NewValue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <Button Content="Previous" Command="{Binding PreviousPageCommand}" Style="{StaticResource NeutralButton}" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyText}">
                        <Run Text="Page "/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource NeutralButton}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ===================== USER MANAGEMENT ===================== -->
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="User Accounts" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,16" MaxWidth="700" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Create User" Style="{StaticResource SectionHeader}"/>

                        <UniformGrid Columns="2" Rows="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="NewUserPasswordBox" PasswordChanged="NewUserPasswordBox_PasswordChanged"/>
                                <Grid Height="6" Margin="0,6,0,4" HorizontalAlignment="Left" Width="160">
                                    <Border Background="{DynamicResource BorderBrush}" CornerRadius="3"/>
                                    <Border Background="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToBrush}}"
                                            CornerRadius="3" HorizontalAlignment="Left"
                                            Width="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToWidth}}"/>
                                </Grid>
                                <TextBlock Text="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToLabel}}"
                                           FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="NewUserConfirmPasswordBox" PasswordChanged="NewUserConfirmPasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Role" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding NewRole}" SelectedValuePath="Content" MaxWidth="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Administrator"/>
                                <ComboBoxItem Content="Supervisor"/>
                                <ComboBoxItem Content="Clerk" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Security Questions (required for account recovery)" Style="{StaticResource SectionHeader}" FontSize="13"/>
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Question 1" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableSecurityQuestions}" SelectedItem="{Binding NewQuestion1}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,10">
                                <TextBlock Text="Question 2" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableSecurityQuestions}" SelectedItem="{Binding NewQuestion2}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Question 3" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableSecurityQuestions}" SelectedItem="{Binding NewQuestion3}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Answer 1" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewAnswer1, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Answer 2" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewAnswer2, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Answer 3" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding NewAnswer3, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>

                        <Button Content="Create User" Command="{Binding CreateUserCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Grid.Row="2" Padding="0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16,10">
                            <Button Content="Deactivate Selected" Command="{Binding DeactivateUserCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0"/>
                            <Button Content="Reactivate Selected" Command="{Binding ReactivateUserCommand}" Style="{StaticResource SuccessButton}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}"/>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}"/>
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}"/>
                                <DataGridTemplateColumn Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,3" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BadgeNeutralBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeDangerBg}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource BadgeNeutralFg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===================== SETTINGS ===================== -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel Margin="24">
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left"
                        Visibility="{Binding CanChangeSystemSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Company &amp; Payroll Defaults" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Company Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Currency Code (e.g. KES, USD)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Currency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Default Daily Wage Rate" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DefaultDailyWageRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Contact Person" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyContactPerson, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Phone" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="50"/>

                        <TextBlock Text="Registration / Tax Number (e.g. KRA PIN)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Website" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CompanyWebsite, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <CheckBox Content="Dark Mode" IsChecked="{Binding IsDarkMode}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Visibility="{Binding CanChangeSystemSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Job Roles" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="These are the roles offered when registering or editing a worker. Keeping this list managed here (rather than free text on the worker form) keeps every worker's role consistent for filtering and reporting."/>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding JobRoles}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource NeutralButton}"
                                                    Padding="8,3" FontSize="11"
                                                    Command="{Binding DataContext.RemoveJobRoleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="240" Text="{Binding NewJobRoleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"
                                     Tag="e.g. Scaffolder"/>
                            <Button Content="Add Role" Command="{Binding AddJobRoleCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Visibility="{Binding CanManageBackups, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Backup &amp; Data Safety" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12">
                            <Run Text="A backup of the database is taken automatically every time the app starts (last 10 kept). You can also trigger one manually below."/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Backup Now" Command="{Binding BackupNowCommand}" Margin="0,0,10,0"/>
                            <Button Content="Open Backups Folder" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource NeutralButton}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding CanRestoreBackups, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Restore From Backup" Style="{StaticResource SectionHeader}" FontSize="14"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10">
                                <Run Text="Restoring replaces the current database with the selected backup. A safety snapshot of the current data is taken automatically first, in case the wrong backup is chosen."/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ComboBox Width="300" ItemsSource="{Binding AvailableBackups}"
                                          SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="DisplayLabel"
                                          Margin="0,0,10,0"/>
                                <Button Content="Refresh List" Command="{Binding RefreshBackupsCommand}" Style="{StaticResource NeutralButton}"/>
                            </StackPanel>
                            <Button Content="Restore Selected Backup" Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,0"
                        Visibility="{Binding CanChangeSystemSettings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Login Security Policy" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Max Failed Login Attempts Before Lockout" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MaxFailedLoginAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Lockout Duration (minutes)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding LockoutDurationMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="Session Idle Timeout (minutes)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SessionIdleTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14">
                            <Run Text="If there's no mouse or keyboard activity for this long, you'll be signed out automatically and asked to sign in again."/>
                        </TextBlock>

                        <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Change My Password" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="{Binding LoggedInUserDisplay}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>

                        <TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="CurrentPasswordBox" PasswordChanged="CurrentPasswordBox_PasswordChanged" Margin="0,0,0,12"/>

                        <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="SettingsNewPasswordBox" PasswordChanged="SettingsNewPasswordBox_PasswordChanged"/>
                        <Grid Height="6" Margin="0,6,0,4" HorizontalAlignment="Left" Width="160">
                            <Border Background="{DynamicResource BorderBrush}" CornerRadius="3"/>
                            <Border Background="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToBrush}}"
                                    CornerRadius="3" HorizontalAlignment="Left"
                                    Width="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToWidth}}"/>
                        </Grid>
                        <TextBlock Text="{Binding NewPasswordStrength, Converter={StaticResource PwStrengthToLabel}}"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                        <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="SettingsConfirmNewPasswordBox" PasswordChanged="SettingsConfirmNewPasswordBox_PasswordChanged" Margin="0,0,0,16"/>

                        <Button Content="Change Password" Command="{Binding ChangePasswordCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding PasswordChangeMessage}" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" MaxWidth="500" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Active Session" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
                            <Run Text="Signed in as: " FontWeight="SemiBold"/>
                            <Run Text="{Binding LoggedInUserDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,4">
                            <Run Text="Since: "/>
                            <Run Text="{Binding SignedInSince, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16">
                            <Run Text="You'll be automatically signed out after "/>
                            <Run Text="{Binding SessionIdleTimeoutMinutes, Mode=OneWay}"/>
                            <Run Text=" minute(s) of inactivity."/>
                        </TextBlock>
                        <Button Content="Log Out Now" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===================== DEVELOPERS / ABOUT ===================== -->
        <DataTemplate DataType="{x:Type vm:DevelopersViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="About &amp; Developers" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <!-- Gradient header banner, matching every export/receipt -->
                    <Border CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#4338CA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="24,20">
                            <TextBlock Text="{Binding AppName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Payroll and attendance management for daily-wage and casual labor teams"
                                       FontSize="12" Foreground="#E0E7FF" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="About This App" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,16">
                                <Run Text="A practical, offline-first payroll and attendance tool, built for teams that need software that works without depending on a data connection."/>
                            </TextBlock>

                            <TextBlock Text="Support &amp; Development" Style="{StaticResource SectionHeader}" FontSize="14"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12">
                                <Run Text="Questions, feature requests, or something not working right? Reach out any of these ways."/>
                            </TextBlock>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="@" FontSize="16" FontWeight="Bold" Foreground="#4F46E5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Email" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PrimaryEmail}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Email" Command="{Binding EmailPrimaryCommand}"
                                        Style="{StaticResource NeutralButton}" Padding="12,5" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="&#128241;" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="WhatsApp / Call" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PrimaryPhone}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="WhatsApp" Command="{Binding WhatsAppPrimaryCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="12,5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Content="Call" Command="{Binding CallPrimaryCommand}"
                                            Style="{StaticResource NeutralButton}" Padding="12,5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Marketing &amp; Sales" Style="{StaticResource SectionHeader}" FontSize="14"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12">
                                <Run Text="Interested in Alchemist PayTrack for your organization, or want to discuss partnership and licensing? Contact the marketing team directly."/>
                            </TextBlock>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="@" FontSize="16" FontWeight="Bold" Foreground="#B45309"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Email" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MarketerEmail}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="Email" Command="{Binding EmailMarketerCommand}"
                                        Style="{StaticResource NeutralButton}" Padding="12,5" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                                    <TextBlock Text="&#128241;" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="WhatsApp / Call" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding MarketerPhone}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="WhatsApp" Command="{Binding WhatsAppMarketerCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="12,5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Content="Call" Command="{Binding CallMarketerCommand}"
                                            Style="{StaticResource NeutralButton}" Padding="12,5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding CopyrightLine}" Style="{StaticResource MutedText}" FontSize="10.5"
                               HorizontalAlignment="Left" Margin="4,0,0,24"/>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,26">
                    <TextBlock Text="Alchemist" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="PAYTRACK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SidebarForegroundMutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding LoggedInUserDisplay}" FontSize="11" Foreground="{DynamicResource SidebarForegroundMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button Command="{Binding NavigateDashboardCommand}" ToolTip="Overview of attendance, payroll, and activity">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDashboardActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateClockCommand}" ToolTip="Clock workers in and out for today">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsClockActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Clock In / Out" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigatePayrollCommand}" ToolTip="Calculate and export payroll for a period"
                            Visibility="{Binding CanUsePayroll, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPayrollActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Payroll" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigatePaymentsCommand}" ToolTip="Record payments and advances to workers"
                            Visibility="{Binding CanUsePayments, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaymentsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Payments" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateWorkersCommand}" ToolTip="Add, edit, and deactivate worker profiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkersActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Workers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateActivityLogCommand}" ToolTip="Audit trail of actions taken in the app"
                            Visibility="{Binding CanViewAuditLogs, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActivityLogActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Activity Log" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateUserManagementCommand}" ToolTip="Manage who can sign in to this app"
                            Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUserManagementActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔐" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="User Accounts" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateSettingsCommand}" ToolTip="Company info, currency, backups, and appearance">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SidebarActiveBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="15" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <!-- Quick dark-mode toggle, always visible at the bottom of the sidebar -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,16">
                    <CheckBox Content="Dark Mode" IsChecked="{Binding Settings.IsDarkMode}"
                              Foreground="{DynamicResource SidebarForegroundBrush}" Margin="0,0,0,14"/>

                    <Button Command="{Binding NavigateDevelopersCommand}" HorizontalContentAlignment="Left"
                            ToolTip="About this application and how to reach the developers"
                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{x:Static vm:AppBranding.DeveloperAttributionShort}" FontSize="9.5"
                                   Foreground="{DynamicResource SidebarForegroundMutedBrush}" TextWrapping="Wrap" Opacity="0.8"
                                   TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== PAGE CONTENT ===================== -->
        <ScrollViewer Grid.Column="1" Style="{StaticResource ScrollablePanel}">
            <ContentControl Content="{Binding CurrentView}"/>
        </ScrollViewer>

        <!-- Watermark spans the full window (sidebar + content) -->
        <vm:WatermarkOverlay Grid.ColumnSpan="2"/>
    </Grid>
</Window>
