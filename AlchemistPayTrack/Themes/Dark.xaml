<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core brand (kept consistent with light theme for brand recognition) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#818CF8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="NeutralHoverBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>

    <!-- App surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="SkeletonBrush" Color="#334155"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#020617"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarForegroundMutedBrush" Color="#94A3B8"/>

    <!-- Status badges (pill background / foreground pairs) -->
    <SolidColorBrush x:Key="BadgeSuccessBg" Color="#14532D"/>
    <SolidColorBrush x:Key="BadgeSuccessFg" Color="#86EFAC"/>
    <SolidColorBrush x:Key="BadgeDangerBg" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="BadgeDangerFg" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="BadgeWarningBg" Color="#78350F"/>
    <SolidColorBrush x:Key="BadgeWarningFg" Color="#FCD34D"/>
    <SolidColorBrush x:Key="BadgeInfoBg" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="BadgeInfoFg" Color="#93C5FD"/>
    <SolidColorBrush x:Key="BadgeNeutralBg" Color="#334155"/>
    <SolidColorBrush x:Key="BadgeNeutralFg" Color="#CBD5E1"/>

    <!--
        Default WPF controls that don't have an explicit style in App.xaml
        (most importantly: a ComboBox's dropdown popup, and DataGrid/List
        selection highlighting) render using the *system's* theme colors,
        not ours - because their built-in control templates reference
        SystemColors.WindowBrush, SystemColors.HighlightBrush, etc.
        directly, and Foreground is an inherited property that flows down
        into that popup regardless. The practical effect in dark mode: a
        ComboBox's own Foreground gets set to a light color by our style
        above, that light color inherits into the dropdown list, but the
        dropdown's popup background stays the OS default (usually white) -
        light text on a white popup is exactly the "text you can't see"
        bug. Overriding these SystemColors keys is the standard WPF fix:
        every default template that reads them (popups, selection
        highlights, etc.) picks up the theme automatically, without having
        to hand-write a full custom ControlTemplate for every control.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E293B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E293B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E293B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#6366F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#64748B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F1F5F9"/>

</ResourceDictionary>
