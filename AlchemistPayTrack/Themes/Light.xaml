<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core brand -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="NeutralHoverBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="#7C3AED"/>

    <!-- App surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SkeletonBrush" Color="#E5E7EB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SidebarForegroundMutedBrush" Color="#9CA3AF"/>

    <!-- Status badges (pill background / foreground pairs) -->
    <SolidColorBrush x:Key="BadgeSuccessBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="BadgeSuccessFg" Color="#166534"/>
    <SolidColorBrush x:Key="BadgeDangerBg" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BadgeDangerFg" Color="#991B1B"/>
    <SolidColorBrush x:Key="BadgeWarningBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BadgeWarningFg" Color="#92400E"/>
    <SolidColorBrush x:Key="BadgeInfoBg" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BadgeInfoFg" Color="#1E40AF"/>
    <SolidColorBrush x:Key="BadgeNeutralBg" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="BadgeNeutralFg" Color="#374151"/>

    <!--
        Matches the equivalent overrides in Dark.xaml (see the comment
        there for why these exist: default control templates for things
        like a ComboBox's dropdown popup or DataGrid selection highlight
        read directly from SystemColors, not from our own brush keys).
        These values match this theme's own existing colors above, so
        light mode's appearance is unchanged from before - this is here
        for symmetry with Dark.xaml and so light mode doesn't regress if
        Windows' own OS theme is ever set to something unusual.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#111827"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#111827"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#111827"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F46E5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111827"/>

</ResourceDictionary>
