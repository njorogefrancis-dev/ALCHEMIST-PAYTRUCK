<UserControl x:Class="AlchemistPayTrack.Presentation.WatermarkOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AlchemistPayTrack.Presentation"
             IsHitTestVisible="False">
    <Grid ClipToBounds="True">
        <Viewbox Stretch="Uniform" Opacity="0.07"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 MaxWidth="520" MaxHeight="520">
            <TextBlock Text="{x:Static local:AppBranding.WatermarkShort}"
                       FontSize="72" FontWeight="Bold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform Angle="-35"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Viewbox>
    </Grid>
</UserControl>
